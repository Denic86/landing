---
interface Props {
  check?: Boolean;
  id: string;
  [key: string]: unknown;
}

const { check, id, ...rest } = Astro.props;
---

<style>
  .portfolioCard {
    height: 100%;
    transition: background-color 0.3s linear;
  }

  a > .portfolioCard:hover {
    background-color: var(--color-grey-2);
  }
</style>

{
  check ? (
    <input checked type="radio" id={id} />
  ) : (
    <input type="radio" id={id} />
  )
}
